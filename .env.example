# Optional Firebase live sync (phone view on other devices). Leave everything empty to run fully offline.
# Copy to .env.local (ignored by git) and fill in from Firebase console > Project settings > Your apps > Web app.
# These are SAFE EXAMPLE PLACEHOLDERS, not real values.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional: test against a local Firestore emulator instead of a real project ("host:port").
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
